<?xml version="1.0" encoding="utf-8"?>
<!-- Long-press Barati's icon: a new card, without opening a deck first. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="new_card"
        android:icon="@drawable/ic_shortcut_add"
        android:shortcutShortLabel="@string/shortcut_new_card_short"
        android:shortcutLongLabel="@string/shortcut_new_card_long">
        <intent
            android:action="io.github.meko123456.barati.action.NEW_CARD"
            android:targetClass="io.github.meko123456.barati.android.MainActivity"
            android:targetPackage="io.github.meko123456.barati" />
    </shortcut>
</shortcuts>
